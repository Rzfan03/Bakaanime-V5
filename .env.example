# Backend (Vercel Serverless Functions) — jangan commit nilai asli
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
AUTH_SECRET=random-32-byte-string

# Frontend (Vite) — expose ke client, aman
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Saat dev lokal pakai `vercel dev` (http://localhost:3000), set:
# VITE_API_URL=http://localhost:3000/api
# Di production biarkan kosong agar pakai same-origin /api
VITE_API_URL=
