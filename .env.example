# Server-side secrets (Vercel Serverless Functions) — never commit real values
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_SECRET=random-32-byte-string
CLERK_SECRET_KEY=sk_test_xxxxxxxx
# Legacy dev-login key (optional, kept for keys already in circulation)
DEV_ACCESS_KEY=

# Client-side (Vite) — bundled into the browser, safe to expose
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Local dev with `vercel dev` (http://localhost:3000):
# VITE_API_URL=http://localhost:3000/api
# In production leave empty to use the same-origin /api
VITE_API_URL=

# Optional: override the Clerk Frontend API host used by the /__clerk proxy
# CLERK_FAPI_URL=
